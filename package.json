{
  "name": "btcc-copy-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sentinel": "node scripts/start-btcc-sentinel.mjs",
    "browser:chrome": "node scripts/launch-btcc-chrome.mjs",
    "browser:doctor": "node scripts/btcc-browser-doctor.mjs",
    "browser:scan": "node scripts/btcc-browser-worker.mjs",
    "browser:scan:once": "node scripts/btcc-browser-worker.mjs --once",
    "browser:scan:dry": "node scripts/btcc-browser-worker.mjs --once --dry-run",
    "btcc:audit": "node scripts/btcc-browser-audit.ts",
    "connect:btcc": "pnpm browser:doctor && pnpm browser:scan:once",
    "monitor:btcc": "pnpm browser:doctor && pnpm browser:scan",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  }
}
