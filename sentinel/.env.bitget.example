# Bitget API credentials: store only in the local Sentinel environment/secret manager.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_API_BASE_URL=https://api.bitget.com

# Keep false until Bitget account permissions, project IDs and end-to-end checks are verified.
BITGET_COPY_LIVE_ENABLED=false

# Comma-separated Bitget project IDs that this Sentinel instance is allowed to manage.
BITGET_COPY_ALLOWED_PROJECT_IDS=

# Independent control token required by Bitget mutation routes.
SENTINEL_CONTROL_TOKEN=

BITGET_COPY_INTERNAL_TRANSFER_ENABLED=false
BITGET_COPY_FUND_SOURCE=
GEM_AUTO_COPY_EXECUTION_ENABLED=false
GEM_AUTO_STOP_REPLACE_ENABLED=false
GEM_AI_REVIEW_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
SENTINEL_TIMEZONE=Africa/Lagos
