# Add real values only through the deployment provider's encrypted environment UI.
# Never commit this file with values and never paste credentials into chat.
BTCC_API_BASE_URL=
BTCC_API_KEY=
BTCC_SECRET_KEY=
BTCC_USERNAME=
BTCC_PASSWORD=
BTCC_ACCOUNT_ID=
LIVE_CONFIRMATION_SECRET=
BTCC_MAX_LEVERAGE=5
BTCC_MAX_ORDER_NOTIONAL_USDT=10
BTCC_LIVE_EXECUTION=false

# Finite BTC purchase controller: Switchere purchase orders settle BTC to one fixed BTCC deposit address.
# The amount per purchase is chosen at runtime; PURCHASE_MAX_TOTAL_FIAT is the deployment-level ceiling for one finite plan.
# No OTP/2FA value is stored or replayed by this service.
SWITCHERE_API_BASE_URL=https://switchere.com
SWITCHERE_PARTNER_API_KEY=
SWITCHERE_PARTNER_API_SECRET=
BTCC_BTC_DEPOSIT_ADDRESS=
PURCHASE_CONTROL_SECRET=
# Optional separate signing secret; if omitted, LIVE_CONFIRMATION_SECRET is used.
PURCHASE_CONFIRMATION_SECRET=
PURCHASE_MAX_TOTAL_FIAT=
PURCHASE_MAX_EXECUTIONS=10
PURCHASE_PLAN_TTL_SECONDS=300
# Read-only order reconciliation can continue after the short execution token expires.
PURCHASE_RECONCILE_MAX_AGE_SECONDS=86400
PURCHASE_LIVE_EXECUTION=false

# Steel cloud browser control for /steel on Vercel.
# STEEL_API_KEY comes from Steel and stays server-side.
# STEEL_CONTROL_SECRET is your own 16+ character passphrase used to unlock the private controller UI.
STEEL_API_KEY=
STEEL_CONTROL_SECRET=
# Optional: use a separate 32+ character secret for encrypting the HttpOnly Steel state cookie.
# If omitted, STEEL_CONTROL_SECRET is used as the encryption source.
STEEL_STATE_SECRET=

# BTCC Sentinel bridge. Use localhost only for local development.
# For cloud deployment, set SENTINEL_URL to the persistent Render service URL.
SENTINEL_URL=http://127.0.0.1:8421
# Must match the secret configured on the Sentinel host. Server-side only; never expose with NEXT_PUBLIC_.
SENTINEL_CONTROL_TOKEN=

# Read-only authenticated browser worker.
# Launch a dedicated Chrome/Chromium instance with remote debugging enabled, then log into BTCC manually there.
BTCC_CDP_HTTP=http://127.0.0.1:9222
BTCC_MANAGER_URL=http://127.0.0.1:3000
BTCC_SCAN_INTERVAL_MS=60000
BTCC_MAX_TRADER_PAGES=25
BTCC_NAVIGATION_DELAY_MS=1800

# GEM Copy Center cloud account. Configure only after creating the approved Supabase project.
SUPABASE_URL=
# Use the public anon/publishable key only. Never use or add a service-role key here.
SUPABASE_ANON_KEY=
# Origin only; the app appends /copy-center for confirmation redirects.
COPY_CENTER_SITE_URL=
